<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_jobiba_queue" model="ir.cron">
        <field name="name">Jobiba: send queued jobs</field>
        <field name="model_id" ref="model_jobiba_sync_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_jobiba_pull" model="ir.cron">
        <field name="name">Jobiba: read job states and applications</field>
        <field name="model_id" ref="model_jobiba_instance"/>
        <field name="state">code</field>
        <field name="code">model._cron_pull()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_jobiba_housekeeping" model="ir.cron">
        <field name="name">Jobiba: delete old events and logs</field>
        <field name="model_id" ref="model_jobiba_instance"/>
        <field name="state">code</field>
        <field name="code">model._cron_housekeeping()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
