<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_jobiba" model="ir.module.category">
        <field name="name">Jobiba</field>
        <field name="description">Who may publish jobs on Jobiba and who may configure the connection.</field>
        <field name="sequence">22</field>
    </record>

    <record id="group_jobiba_user" model="res.groups">
        <field name="name">Recruiter: publish jobs and see sync state</field>
        <field name="category_id" ref="module_category_jobiba"/>
        <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_interviewer'))]"/>
    </record>

    <record id="group_jobiba_manager" model="res.groups">
        <field name="name">Integration administrator: connection, keys and logs</field>
        <field name="category_id" ref="module_category_jobiba"/>
        <field name="implied_ids" eval="[(4, ref('group_jobiba_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Recruitment officers publish; recruitment administrators approve (checked in code). -->
    <record id="hr_recruitment.group_hr_recruitment_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_jobiba_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_jobiba_instance_company" model="ir.rule">
            <field name="name">Jobiba connection: own companies</field>
            <field name="model_id" ref="model_jobiba_instance"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_jobiba_job_mapping_company" model="ir.rule">
            <field name="name">Jobiba job link: own companies</field>
            <field name="model_id" ref="model_jobiba_job_mapping"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_jobiba_sync_job_company" model="ir.rule">
            <field name="name">Jobiba queue: own companies</field>
            <field name="model_id" ref="model_jobiba_sync_job"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_jobiba_sync_log_company" model="ir.rule">
            <field name="name">Jobiba log: own companies</field>
            <field name="model_id" ref="model_jobiba_sync_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_jobiba_webhook_event_company" model="ir.rule">
            <field name="name">Jobiba webhook event: own companies</field>
            <field name="model_id" ref="model_jobiba_webhook_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_jobiba_application_mapping_company" model="ir.rule">
            <field name="name">Jobiba application link: own companies</field>
            <field name="model_id" ref="model_jobiba_application_mapping"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
